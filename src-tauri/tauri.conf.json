{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Daily Route",
  "version": "0.1.0",
  "identifier": "com.dailyroute.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cross-env VITE_IS_TAURI=true && pnpm start",
    "beforeBuildCommand": "cross-env VITE_IS_TAURI=true && pnpm run build",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "temp",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "android": {
     	"autoIncrementVersionCode": false,
     	"minSdkVersion": 28
    },
    "category": "HealthcareAndFitness",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["dailyrouteapp"],
          "appLink": false
        }
      ]
    }
  }
}
