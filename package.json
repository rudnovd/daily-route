{
  "name": "daily-route",
  "type": "module",
  "version": "0.5.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "download"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:css": "stylelint src/**/*{.css,.vue}",
    "lint:css:fix": "npm run lint:css -- --fix",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build --apk",
    "update-types": "npx supabase gen types --lang=typescript > ./src/types/supabase.ts && eslint --fix ./src/types/supabase.ts",
    "prerelease": "pnpm run build"
  },
  "dependencies": {
    "@maptiler/sdk": "^4.1.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "~2.4.9",
    "@tauri-apps/plugin-geolocation": "~2.3.2",
    "@tauri-apps/plugin-notification": "~2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@turf/turf": "^7.4.0",
    "@vueuse/core": "^14.4.0",
    "driver.js": "^1.8.0",
    "geojson": "^0.5.0",
    "ky": "^2.0.2",
    "pinia": "^3.0.4",
    "supabase": "^2.113.0",
    "temporal-polyfill": "^1.0.3",
    "v-wave": "^3.1.1",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@iconify-json/mdi": "^1.2.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "24.13.2",
    "@types/project-osrm__osrm": "^5.27.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-format": "^2.0.1",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-rem-over-px": "^2.0.0",
    "typescript": "~6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9"
  }
}
